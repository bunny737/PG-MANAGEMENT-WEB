# nginx edge for pglive.in on the pglive-worker VM (owner decision 2026-10-21: no load balancer).
# Written for Debian 12's nginx 1.22 (hence "listen ... http2" rather than the 1.25+ "http2 on;").
# Rendered by infra/edge/setup-edge.sh into /etc/nginx/conf.d/pglive.conf; ${API_HOST} and ${WEB_HOST} are the
# Cloud Run *.run.app hostnames. Cloud Run ingress is "internal": only this VM (same project VPC) can reach it.
#
# What this file does in place of the load balancer (docs/deployment.md):
# - X-PGLive-Client-IP is overwritten with the real peer address, so Django's client-IP trust holds;
# - Strict-Transport-Security is set here and only here (Django and Next send none);
# - X-Forwarded-Host carries the public host: Cloud Run routes on Host, so Host must be the run.app name, and the
#   BFF's same-origin check (frontend/src/lib/server/bff.ts) compares Origin with X-Forwarded-Host;
# - the request URI is passed through untouched (no URI part in proxy_pass), which the BFF origin signature needs;
# - login endpoints are rate-limited per client IP (what Cloud Armor did);
# - /admin/ is allowed only from the addresses in /etc/nginx/pglive-admin-allow.conf.

resolver 169.254.169.254 valid=300s ipv6=off;   # GCE metadata DNS; run.app addresses are re-resolved, not pinned
limit_req_zone $binary_remote_addr zone=pglive_auth:10m rate=60r/m;
limit_req_status 429;

# Plain HTTP: certificate challenges, everything else to HTTPS. Unknown hosts get no answer.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name pglive.in www.pglive.in api.pglive.in;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate     /etc/letsencrypt/live/pglive.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pglive.in/privkey.pem;
    return 444;
}

# Bare domain -> www (one redirect, with HSTS).
server {
    listen 443 ssl http2;
    server_name pglive.in;
    include /etc/nginx/snippets/pglive-tls.conf;
    return 301 https://www.pglive.in$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.pglive.in;
    include /etc/nginx/snippets/pglive-tls.conf;
    set $upstream_host ${WEB_HOST};

    location /api/auth/ {
        limit_req zone=pglive_auth burst=20 nodelay;
        include /etc/nginx/snippets/pglive-proxy.conf;
    }
    location / {
        include /etc/nginx/snippets/pglive-proxy.conf;
    }
}

server {
    listen 443 ssl http2;
    server_name api.pglive.in;
    include /etc/nginx/snippets/pglive-tls.conf;
    set $upstream_host ${API_HOST};

    location /api/v1/auth/ {
        limit_req zone=pglive_auth burst=20 nodelay;
        include /etc/nginx/snippets/pglive-proxy.conf;
    }
    location /admin/ {
        include /etc/nginx/pglive-admin-allow.conf;
        include /etc/nginx/snippets/pglive-proxy.conf;
    }
    location / {
        include /etc/nginx/snippets/pglive-proxy.conf;
    }
}
