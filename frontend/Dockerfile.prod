# Production image for the Next.js app + BFF (docs/deployment.md, WP2). The dev image is ./Dockerfile.
#
# NEXT_PUBLIC_* values (Firebase, Maps) are inlined into the client bundle AND the Serwist service
# worker at build time, so they are build args — one image per environment. The launch-gate values
# (SITE_URL, COMPANY_*, APP_STATUS, ...) are checked by `next build` and again at server start
# (src/instrumentation.ts), so they are build args here and runtime env on Cloud Run too.
# None of these are secrets; BFF_ORIGIN_SECRET and friends arrive only at runtime.

FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci


FROM node:24-alpine AS build
WORKDIR /app
ARG SITE_URL
ARG SITE_ENV=production
ARG COMPANY_NAME
ARG COMPANY_ADDRESS
ARG APP_STATUS=comingSoon
ARG PLAY_STORE_URL=
ARG SIGNUP_ENABLED=
ARG NEXT_PUBLIC_FIREBASE_API_KEY=
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
ARG NEXT_PUBLIC_FIREBASE_APP_ID=
ARG NEXT_PUBLIC_FIREBASE_VAPID_KEY=
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
ARG NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
ENV NEXT_TELEMETRY_DISABLED=1 \
    SITE_URL=$SITE_URL SITE_ENV=$SITE_ENV COMPANY_NAME=$COMPANY_NAME COMPANY_ADDRESS=$COMPANY_ADDRESS \
    APP_STATUS=$APP_STATUS PLAY_STORE_URL=$PLAY_STORE_URL SIGNUP_ENABLED=$SIGNUP_ENABLED \
    NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_FIREBASE_VAPID_KEY=$NEXT_PUBLIC_FIREBASE_VAPID_KEY \
    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY \
    NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=$NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build


FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
# The runtime is `node server.js` only: drop the npm/yarn CLIs the base image bundles. They are never used here
# and carry their own vulnerable dependencies (Trivy flagged npm's undici and brace-expansion).
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn* \
              /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
# Standalone server + the static assets and public/ (incl. the generated sw.js) it doesn't copy.
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER app
EXPOSE 8080
CMD ["node", "server.js"]
