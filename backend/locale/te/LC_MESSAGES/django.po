msgstr "ఫిర్యాదు లేవనెత్తబడింది"

msgid "Notice Given"
msgstr "నోటీసు ఇవ్వబడింది"

#, python-format
msgid "Expected vacate %(date)s"
msgstr "ఖాళీ చేయాల్సిన అంచనా తేదీ %(date)s"

#, python-format
