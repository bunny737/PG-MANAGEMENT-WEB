# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# `backend` is the Host header the Next.js BFF proxy sends from the frontend container.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Hosts (no scheme/port) that may open the Next.js DEV server besides localhost: an ngrok tunnel or
# your PC's LAN IP when testing on a phone. Without it the page renders but its buttons do nothing.
ALLOWED_DEV_ORIGINS=

# Largest request body (bytes) the Next.js BFF proxy will accept; larger uploads get a 413. The backend
# has no upload limit of its own, so this is the effective ceiling. Default: 10485760 (10 MB). If you
# raise it, raise nginx's client_max_body_size in production to match.
BFF_MAX_BODY_BYTES=10485760
CSRF_TRUSTED_ORIGINS=

# Database — the app MUST connect as a non-superuser or RLS is bypassed.
# app_user is created by docker/postgres/init.sql on first init.
DB_NAME=pg_platform
DB_USER=app_user
DB_PASSWORD=app_password
DB_HOST=db
DB_PORT=5432
POSTGRES_ADMIN_PASSWORD=postgres

# Redis / Celery
REDIS_URL=redis://redis:6379/0
# Optional: separate Redis URL for the Django cache (DRF throttle state).
# Defaults to REDIS_URL's host on DB 1 if unset.
REDIS_CACHE_URL=redis://redis:6379/1

# Mobile app version policy (Module 19): off | log | on. Start with log; switch
# to on only after the policy rows are seeded and the new app build is live.
APP_VERSION_ENFORCEMENT=log
# Optional: lets QA bypass maintenance by sending this in X-Maintenance-Bypass.
APP_MAINTENANCE_BYPASS_TOKEN=

# Google Cloud Storage (document uploads). Blank = local filesystem (dev/test).
# On Cloud Run there is no key file: the runtime service account signs URLs through the IAM
# SignBlob API (GS_IAM_SIGN_BLOB) and needs serviceAccountTokenCreator on itself.
GS_BUCKET_NAME=
GS_PROJECT_ID=
GS_SA_EMAIL=
# Lifetime of signed file URLs, seconds.
MEDIA_URL_TTL_SECONDS=300

# --- Production only (config.settings.prod; see docs/deployment.md) ---
# Both must be random, >= 50 chars. JWT_SIGNING_KEY is separate so SECRET_KEY can rotate
# (SECRET_KEY_FALLBACKS) without logging everyone out.
JWT_SIGNING_KEY=
SECRET_KEY_FALLBACKS=
# Header the load balancer overwrites with the caller's address (X-Forwarded-For is never trusted).
CLIENT_IP_HEADER=X-PGLive-Client-IP
# Shared with the Next.js BFF; verifies the browser IP it forwards. Blank rejects such headers.
BFF_ORIGIN_SECRET=
# Backend-service audience of the IAP-protected /admin/ route.
IAP_AUDIENCE=
IAP_REQUIRED=True
# HSTS is set by the load balancer; leave 0 unless Django is served without it.
SECURE_HSTS_SECONDS=0
DB_SSLMODE=require
SENTRY_DSN=
# Frontend: report-only | enforce | off. CSP_REPORT_URI is the Sentry security endpoint.
CSP_MODE=report-only
CSP_REPORT_URI=
# One-time, for the pglive-bootstrap job only (docs/deployment.md); destroy afterwards.
INITIAL_SUPERADMIN_EMAIL=
INITIAL_SUPERADMIN_PASSWORD=

# Razorpay — subscription billing ONLY, never resident payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave FALSE in production. When true, webhook HMAC signature checks are
# skipped if RAZORPAY_WEBHOOK_SECRET is blank (dev/test convenience only).
RAZORPAY_ALLOW_UNSIGNED_WEBHOOKS=False

# Email
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Firebase Cloud Messaging (push notifications — Module 14 V2). Leave blank
# in dev/test: the push channel just logs status=skipped. Set ONE of these
# in production — a mounted service-account JSON file path is preferred;
# the raw JSON env var is the fallback for platforms with no file mounts.
# Docker dev: put the JSON in ./secrets/ (gitignored, mounted read-only at
# /run/secrets in backend/celery/celery-beat) and use the CONTAINER path —
# a host path like D:/... does not exist inside the containers:
#   FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
# On GCP prefer no key at all: the runtime service account (needs FCM send permission).
FIREBASE_USE_ADC=False
FIREBASE_PROJECT_ID=

# Google Maps (Property Map Location Pin)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud console > Map Management): needed for the advanced pin marker. Empty falls back to
# Google's DEMO_MAP_ID, which works for development only.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase Web Push Configuration (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Public marketing site (frontend, docs/frontend-plan.md §12). Read by the Next.js
# server at runtime. A production build/start fails while COMPANY_* are unset;
# use SITE_ENV=staging for any deploy that is not public.
SITE_URL=https://pglive.in
SITE_ENV=staging
COMPANY_NAME=
COMPANY_ADDRESS=
# comingSoon | live (live also needs a real https://play.google.com/... link)
APP_STATUS=comingSoon
PLAY_STORE_URL=
# Flip to true only once /signup exists; until then the CTA is "Request early access".
SIGNUP_ENABLED=false
# Server-side calls to Django (inside the container, localhost is not Django).
INTERNAL_API_URL=http://backend:8000
