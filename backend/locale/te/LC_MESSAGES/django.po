msgid "You are not assigned to this property."
msgstr "మీరు ఈ ప్రాపర్టీకి కేటాయించబడలేదు."

msgid "Discount value must be greater than zero."
msgstr "డిస్కౌంట్ విలువ సున్నా కంటే ఎక్కువగా ఉండాలి."

msgid "A percentage discount cannot exceed 100."
msgstr "శాతం డిస్కౌంట్ 100ని మించకూడదు."

msgid "valid_until cannot be before valid_from."
msgstr "valid_until, valid_from కంటే ముందు ఉండకూడదు."

msgid "This resident already has a discount active in this period."
msgstr "ఈ నివాసికి ఈ కాలంలో ఇప్పటికే క్రియాశీల డిస్కౌంట్ ఉంది."

msgid "Only active residents can be invoiced."
msgstr "క్రియాశీల నివాసులకు మాత్రమే ఇన్‌వాయిస్ చేయవచ్చు."

msgid "This resident is not allocated to a bed."
msgstr "ఈ నివాసికి బెడ్ కేటాయించబడలేదు."

msgid "period_end cannot be before period_start."
msgstr "period_end, period_start కంటే ముందు ఉండకూడదు."

msgid "This resident already has an invoice for this period."
msgstr "ఈ నివాసికి ఈ కాలానికి ఇప్పటికే ఇన్‌వాయిస్ ఉంది."

msgid "Payment amount must be greater than zero."
msgstr "చెల్లింపు మొత్తం సున్నా కంటే ఎక్కువగా ఉండాలి."

msgid "Payments can only be recorded against an issued invoice."
msgstr "జారీ చేయబడిన ఇన్‌వాయిస్‌కు మాత్రమే చెల్లింపులు నమోదు చేయవచ్చు."

msgid "This invoice is already fully paid."
msgstr "ఈ ఇన్‌వాయిస్ ఇప్పటికే పూర్తిగా చెల్లించబడింది."

#, python-format
msgid "Payment exceeds the outstanding balance of %(balance)s."
msgstr "చెల్లింపు %(balance)s బాకీ మిగులును మించిపోయింది."

msgid "Only draft invoices can be modified."
msgstr "డ్రాఫ్ట్ ఇన్‌వాయిస్‌లను మాత్రమే సవరించవచ్చు."

msgid "Line item not found."
msgstr "లైన్ ఐటెమ్ కనుగొనబడలేదు."

msgid "You do not have permission to perform this action."
msgstr "ఈ చర్యను చేయడానికి మీకు అనుమతి లేదు."

msgid "Only platform administrators can perform this action."
msgstr "ప్లాట్‌ఫారమ్ నిర్వాహకులు మాత్రమే ఈ చర్యను చేయగలరు."

msgid "Super Admin"
msgstr "సూపర్ అడ్మిన్"

msgid "Owner"
msgstr "యజమాని"

msgid "Manager"
msgstr "మేనేజర్"

msgid "Receptionist"
msgstr "రిసెప్షనిస్ట్"

msgid "Resident"
msgstr "నివాసి"

#, python-format
msgid "Invoice for %(period)s"
msgstr "%(period)s కోసం ఇన్‌వాయిస్"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"Your invoice for the period %(start)s to %(end)s has been issued.\n"
"Amount due: %(total)s\n"
"Due date: %(due)s\n"
"\n"
"Thank you."
msgstr ""
"ప్రియమైన %(name)s,\n"
"\n"
"%(start)s నుండి %(end)s వరకు కాలానికి మీ ఇన్‌వాయిస్ జారీ చేయబడింది.\n"
"చెల్లించవలసిన మొత్తం: %(total)s\n"
"చెల్లించవలసిన తేదీ: %(due)s\n"
"\n"
"ధన్యవాదాలు."

#, python-format
msgid "Payment receipt — %(amount)s received"
msgstr "చెల్లింపు రసీదు — %(amount)s అందుకోబడింది"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"We have received your payment of %(amount)s on %(date)s via %(mode)s.\n"
"Remaining balance on this invoice: %(balance)s\n"
"\n"
"Thank you."
msgstr ""
"ప్రియమైన %(name)s,\n"
"\n"
"%(date)s న %(mode)s ద్వారా మీ %(amount)s చెల్లింపును మేము అందుకున్నాము.\n"
"ఈ ఇన్‌వాయిస్‌పై మిగిలిన బాకీ: %(balance)s\n"
"\n"
"ధన్యవాదాలు."

#, python-format
msgid "Your trial ends in %(days)s day(s)"
msgstr "మీ ట్రయల్ %(days)s రోజు(ల)లో ముగుస్తుంది"

#, python-format
msgid ""
"Dear %(name)s,\n"
"\n"
"Your free trial of the platform for %(business)s ends in %(days)s day(s), on %(end_date)s. Choose a plan to keep using the platform without interruption.\n"
"\n"
"Thank you."
msgstr ""
"ప్రియమైన %(name)s,\n"
"\n"
"%(business)s కోసం ప్లాట్‌ఫారమ్ యొక్క మీ ఉచిత ట్రయల్ %(days)s రోజు(ల)లో, %(end_date)s న ముగుస్తుంది. అంతరాయం లేకుండా ప్లాట్‌ఫారమ్‌ను ఉపయోగించడం కొనసాగించడానికి ఒక ప్లాన్‌ను ఎంచుకోండి.\n"
"\n"
"ధన్యవాదాలు."

